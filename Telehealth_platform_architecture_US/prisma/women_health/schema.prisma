// Women's Health Brand - Operational Database Schema
// Database: telehealth_women_prod
// Similar structure to men's health with category adaptations

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/women-client"
}

datasource db {
  provider = "postgresql"
  url      = env("WOMEN_DATABASE_URL")
}

// ============================================
// PHARMACEUTICAL DATA
// ============================================

model Product {
  id                String   @id @default(uuid())
  sku               String   @unique
  name              String
  category          ProductCategory
  description       String
  activeIngredients Json
  dosageForm        String
  strength          String
  requiresDEA       Boolean  @default(false)
  fdaApproved       Boolean  @default(true)
  ndcCode           String?
  
  basePrice         Decimal  @db.Decimal(10, 2)
  subscriptionPrice Decimal? @db.Decimal(10, 2)
  insuranceCoverable Boolean @default(false)
  
  inventory         InventoryItem[]
  orderLineItems    OrderLineItem[]
  prescriptions     Prescription[]
  drugInteractions  DrugInteraction[] @relation("ProductA")
  contraindications Contraindication[]
  
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([category])
  @@index([isActive])
  @@map("products")
}

enum ProductCategory {
  GLP1_AGONIST          // Weight management
  PEPTIDE               // Anti-aging, wellness
  HORMONE_THERAPY       // HRT, bioidentical hormones
  FERTILITY_SUPPORT     // Supplements, treatments
  SEXUAL_WELLNESS       // Female sexual health
  HAIR_SKIN_NAILS       // Beauty & wellness
  MENOPAUSE_SUPPORT     // Symptom management
  BIRTH_CONTROL         // Contraceptives
  UTI_TREATMENT         // Urinary health
  MENTAL_WELLNESS       // Anxiety, depression support
  OTHER
}

model InventoryItem {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  
  fulfillmentPartner String
  lotNumber         String
  expirationDate    DateTime
  quantityAvailable Int
  quantityReserved  Int      @default(0)
  quantityOnHold    Int      @default(0)
  
  warehouseLocation String
  binLocation       String?
  
  receivedDate      DateTime
  lastAuditDate     DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([productId, lotNumber])
  @@index([quantityAvailable])
  @@index([expirationDate])
  @@map("inventory")
}

model DrugInteraction {
  id              String   @id @default(uuid())
  productAId      String
  productBId      String
  productA        Product  @relation("ProductA", fields: [productAId], references: [id])
  severity        InteractionSeverity
  description     String
  clinicalEffect  String
  recommendation  String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([productAId, productBId])
  @@map("drug_interactions")
}

enum InteractionSeverity {
  MINOR
  MODERATE
  MAJOR
  CONTRAINDICATED
}

model Contraindication {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  condition   String
  description String
  severity    String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([productId])
  @@map("contraindications")
}

// ============================================
// PATIENT & CLINICAL DATA (ANONYMIZED)
// ============================================

model Patient {
  id                String   @id @default(uuid())
  brand             String   @default("womens")
  registrationDate  DateTime @default(now())
  isActive          Boolean  @default(true)
  
  consultations     Consultation[]
  prescriptions     Prescription[]
  orders            Order[]
  customerProfile   CustomerProfile?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([brand])
  @@index([isActive])
  @@map("patients")
}

model Consultation {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  providerId        String
  
  consultationType  ConsultationType
  status            ConsultationStatus
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  
  chiefComplaint    String
  productInterest   String[]
  assessmentId      String?
  
  prescriptions     Prescription[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([patientId])
  @@index([providerId])
  @@index([status])
  @@map("consultations")
}

enum ConsultationType {
  ASYNC_QUESTIONNAIRE
  VIDEO_CALL
  FOLLOW_UP
  REFILL_REVIEW
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Prescription {
  id                  String   @id @default(uuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id])
  consultationId      String?
  consultation        Consultation? @relation(fields: [consultationId], references: [id])
  providerId          String
  
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  
  dosage              String
  frequency           String
  duration            String
  quantity            Int
  refillsAllowed      Int      @default(0)
  refillsRemaining    Int      @default(0)
  
  status              PrescriptionStatus
  approvedAt          DateTime?
  approvedBy          String?
  filledAt            DateTime?
  filledBy            String?
  
  autoRefillEnabled   Boolean  @default(false)
  nextRefillDate      DateTime?
  
  orders              Order[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([patientId])
  @@index([status])
  @@index([nextRefillDate])
  @@map("prescriptions")
}

enum PrescriptionStatus {
  PENDING_REVIEW
  APPROVED
  DENIED
  FILLED
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
}

// ============================================
// OPERATIONAL DATA
// ============================================

model Order {
  id                String   @id @default(uuid())
  orderNumber       String   @unique
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  
  orderType         OrderType
  prescriptionId    String?
  prescription      Prescription? @relation(fields: [prescriptionId], references: [id])
  
  lineItems         OrderLineItem[]
  
  subtotal          Decimal  @db.Decimal(10, 2)
  tax               Decimal  @db.Decimal(10, 2)
  shipping          Decimal  @db.Decimal(10, 2)
  discount          Decimal  @db.Decimal(10, 2) @default(0)
  total             Decimal  @db.Decimal(10, 2)
  
  paymentIntentId   String?
  paymentStatus     PaymentStatus
  
  status            OrderStatus
  fulfillmentPartner String?
  shippingTrackingNumber String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderType {
  PRESCRIPTION
  ONE_TIME_PURCHASE
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model OrderLineItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([orderId])
  @@map("order_line_items")
}

// ============================================
// CUSTOMER/MARKETING DATA
// ============================================

model CustomerProfile {
  id                String   @id @default(uuid())
  patientId         String   @unique
  patient           Patient  @relation(fields: [patientId], references: [id])
  
  acquisitionChannel String?
  acquisitionCampaign String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  
  segment           String[]
  lifetimeValue     Decimal  @db.Decimal(10, 2) @default(0)
  orderCount        Int      @default(0)
  
  isSubscriber      Boolean  @default(false)
  subscriptionTier  String?
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  
  lastLoginAt       DateTime?
  lastOrderAt       DateTime?
  emailOptIn        Boolean  @default(true)
  smsOptIn          Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([segment])
  @@index([isSubscriber])
  @@map("customer_profiles")
}

// ============================================
// AUDIT LOGGING
// ============================================

model AuditLog {
  id            String   @id @default(uuid())
  tableName     String
  recordId      String
  action        AuditAction
  userId        String?
  changedData   Json
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime @default(now())
  
  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}
